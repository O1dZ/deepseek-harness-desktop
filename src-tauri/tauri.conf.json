{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "DeepSeek Harness Desktop",
  "version": "0.1.0",
  "identifier": "io.github.deepseek-harness-desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist",
    "removeUnusedCommands": true
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "DeepSeek Harness Desktop",
        "width": 1380,
        "height": 900,
        "minWidth": 920,
        "minHeight": 640,
        "center": true,
        "decorations": true,
        "resizable": true,
        "visible": true,
        "url": "index.html"
      },
      {
        "label": "desktop-settings",
        "title": "桌面设置 · DeepSeek Harness",
        "width": 780,
        "height": 720,
        "minWidth": 620,
        "minHeight": 520,
        "center": true,
        "decorations": true,
        "resizable": true,
        "visible": false,
        "url": "settings.html"
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: data:; style-src 'self' 'unsafe-inline'; script-src 'self'; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "category": "DeveloperTool",
    "copyright": "Copyright © DeepSeek Harness Desktop contributors",
    "shortDescription": "Desktop launcher for DeepSeek Harness",
    "longDescription": "A community Windows desktop companion for the official DeepSeek Harness web workspace.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      },
      "nsis": {
        "installerIcon": "icons/icon.ico",
        "installMode": "currentUser",
        "displayLanguageSelector": true,
        "languages": ["SimpChinese", "English"]
      }
    }
  }
}
